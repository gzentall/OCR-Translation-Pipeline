// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth Models
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  username        String   @unique
  passwordHash    String?  // null if passkey-only
  emailVerifiedAt DateTime?
  isActive        Boolean  @default(true)
  role            Role     @default(USER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // NextAuth.js fields
  accounts        Account[]
  sessions        Session[]
  
  // Document relationships
  documents       Document[]
  people          Person[]
  
  // Audit logs
  auditLogs       AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Document Models (from your existing system)
model Document {
  id              String   @id @default(cuid())
  title           String
  dateProcessed   DateTime @default(now())
  sourceLanguage  String   @default("unknown")
  targetLanguage  String   @default("en")
  originalText    String?  @db.Text
  translatedText  String?  @db.Text
  fileSize        Int      @default(0)
  summary         String?  @db.Text
  pageCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relationships
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  people          DocumentPerson[]
  
  // Audit logs
  auditLogs       AuditLog[]
}

model Person {
  id              String   @id @default(cuid())
  name            String   @unique
  aliases         String[] // Array of alternative names
  context         String?  @db.Text
  firstMentioned  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relationships
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       DocumentPerson[]
  
  // Audit logs
  auditLogs       AuditLog[]
}

model DocumentPerson {
  id         String   @id @default(cuid())
  documentId String
  personId   String
  createdAt  DateTime @default(now())
  
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  @@unique([documentId, personId])
}

// Audit Logging
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   // e.g. USER_INVITE, ROLE_CHANGE, LOGIN, DOCUMENT_CREATE
  targetType  String   // USER | DOCUMENT | PERSON | SYSTEM
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  
  // Relationships
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  document    Document? @relation(fields: [targetId], references: [id], onDelete: SetNull, map: "AuditLog_document_fkey")
  person      Person?  @relation(fields: [targetId], references: [id], onDelete: SetNull, map: "AuditLog_person_fkey")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}